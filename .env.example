# =============================================================================
# IBVAP — Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# The .env file is git-ignored and must NEVER be committed.
#   cp .env.example .env
# =============================================================================

# --- Supabase Database ---
# Create a project at https://supabase.com, then:
# Settings → API → Project URL and anon/service-role keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-key...
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key...
# NOTE: Only SUPABASE_SERVICE_KEY is used by the backend (server-side).
# The dashboard never receives DB credentials — it only talks to FastAPI.

# --- Backend API (FastAPI) ---
# Host and port the FastAPI backend listens on
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Dashboard Frontend (Vite / React) ---
# Set VITE_API_URL only when running the dashboard WITHOUT the Vite proxy
# (e.g. a production/Docker build hitting a remote backend).
# Leave blank when using `npm run dev` — the Vite proxy at localhost:5173
# will forward /api and /ws automatically to BACKEND_PORT.
VITE_API_URL=

# Port Vite dev-server listens on
VITE_PORT=5173

# --- Edge Streaming ---
# The backend launches edge worker sub-processes.
# Each camera gets its own HTTP MJPEG stream port, starting from this value.
EDGE_STREAM_PORT_START=8081

# --- Backend Config ---
# Path to the YAML config loaded by apps/backend/main.py
BACKEND_CONFIG=configs/backend_default.yaml

# --- Mock / Development Flags ---
# Set to true to inject fake camera state, chart data, and alert events
# without needing a running edge node. Useful for dashboard-only development.
MOCK_CAMERA_STATE=false
MOCK_CHARTS=false
MOCK_ALERTS=false

# --- Database (future / Phase 10+) ---
# Leave enabled=false until a real DB backend is wired up
DATABASE_ENABLED=false
DATABASE_URL=sqlite:///./backend.db
