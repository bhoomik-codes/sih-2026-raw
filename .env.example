# ==============================================================================
# IBVAP — Intelligent Border Video Analytics Platform Environment Configuration
# ==============================================================================

# Supabase Project Configuration
SUPABASE_URL=https://***.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Supabase PostgreSQL Database Connection URI
# Direct connection (port 5432) or Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres:your-db-password@db.***.supabase.co:5432/postgres
DATABASE_ENABLED=true

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
MOCK_CAMERA_STATE=false
MOCK_CHARTS=false
MOCK_ALERTS=false

# Edge AI Configuration
EDGE_NODE_ID=EDGE-NODE-01
DEFAULT_STREAM_PORT=8081
